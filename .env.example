# Copie para ai_engine/.env e preencha. NUNCA commite o .env real.
HUBSPOT_ACCESS_TOKEN=seu_token_privado_do_hubspot_aqui
WEBHOOK_SECRET=um_segredo_longo_e_aleatorio
# IA: se ANTHROPIC_API_KEY existir usa Claude; senão cai para Ollama local.
ANTHROPIC_API_KEY=
IA_PROVEDOR=            # claude | ollama (vazio = automático)
CLAUDE_MODELO=claude-sonnet-5-5
CLAUDE_ESFORCO=medium
OLLAMA_MODEL=qwen3:14b
WHISPER_MODELO=small
ATUALIZAR_HUBSPOT=0     # 1 = grava de verdade no CRM
FOLLOWUP_DIAS=2
MAX_FOLLOWUPS=2
RESPONDER_MINUTOS=30
FUSO_REUNIOES=America/New_York
PORTA_CEREBRO=5000
# Ponte WhatsApp (Node)
ESPERA_SEGUNDOS=30
ANALISES_SIMULTANEAS=2
ALERTA_HORARIOS=09:00,15:00
VARREDURA_MINUTOS=30
